# Port the HTTP + WebSocket server listens on.
PORT=2567

# Comma-separated origins allowed to call the HTTP API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,https://bloxity.io

# Secret used to sign the game's own session tokens after the Bloxity handshake.
SESSION_SECRET=change-me-to-a-long-random-string

# Bloxity API used to verify player tokens (Bearer call on the player's behalf).
LEGION_API_URL=https://api.bloxity.io
LEGION_VERIFY_PATH=/v1/social/profile

# Shared secret Bloxity sends in the x-legion-webhook-secret header for Gems purchases.
LEGION_WEBHOOK_SECRET=

# Stats reporting to Bloxity profiles (leave empty to disable).
BLOXITY_GAME_ID=
BLOXITY_REPORT_TOKEN=

# Where player profiles are stored.
DATA_DIR=./data
