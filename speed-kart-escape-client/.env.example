# Bloxity game slug (must match the slug registered on bloxity.io).
VITE_GAME_SLUG=speed-kart-escape

# Local development: HTTP base of the game server (auth handshake + leaderboards)
# and the WebSocket endpoint used when the game is NOT hosted on Bloxity.
VITE_SERVER_HTTP=http://localhost:2567
VITE_SERVER_WS=ws://localhost:2567

# Set to "true" when the server is hosted on Bloxity: the client then resolves the
# socket endpoint with Legion.SDK.net.resolveEndpoint() on every connection.
VITE_BLOXITY_HOSTED=false

# Boxity hosting id (the <id> in <id>.host.bloxity.io). Used with
# Legion.SDK.net.resolveEndpoint('<id>') when VITE_BLOXITY_HOSTED=true. Never point
# the game socket at <id>.host.bloxity.io directly. Defaults to the game slug.
VITE_BLOXITY_HOSTING_ID=
